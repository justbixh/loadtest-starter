# Source from the project root after loading .env:
#   set -a && . ./.env && set +a
#
# Project shortcuts. The servers and load tests use LOADBASE.

alias load='cd "$LOADBASE"'
alias lok='cd "$LOADBASE/k6" && k6 run order-create.js'
alias gat='cd "$LOADBASE/gatling"'
alias gat='cd "$LOADBASE/gatling" && ./mvnw gatling:test -Dgatling.simulationClass=simulations.OrderCreateSimulation'

gatrun() {
  cd "$LOADBASE/gatling" && ./mvnw gatling:test \
    -Dgatling.simulationClass="simulations.$1"
}
